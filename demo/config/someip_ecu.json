{
    "_comment": "vsomeip configuration for the native SOME/IP application. The ROS side's is generated by the RMW.",
    "unicast": "172.40.0.11",
    "netmask": "255.255.255.0",
    "logging": { "level": "warning", "console": "true", "file": { "enable": "false" }, "dlt": "false" },
    "applications": [ { "name": "someip_ecu", "id": "0x1111" } ],
